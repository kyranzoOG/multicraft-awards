# GEMINI_API_KEY: Required for Gemini AI API calls if used server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (injected at runtime).
APP_URL="MY_APP_URL"

# SUPABASE CLIENT CREDENTIALS (Safe for client bundle / React Vite .env.local)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE SERVER CREDENTIALS (Never expose SERVICE_ROLE_KEY to the frontend)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# OPTIONAL STATIC GITHUB PAGES BUILD VARIABLES
VITE_BASE_PATH="/"
VITE_PUBLIC_SITE_URL="https://your-username.github.io/your-repo"
